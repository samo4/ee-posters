# Poster build. latexmkrc holds the engine and the build/ dir; the finished PDF is copied
# next to the source so an open viewer tab (vscode-pdf) reloads it in place.
main := "loudspeaker-enclosures"

default: poster

poster file=main:
    latexmk {{file}}.tex
    cp build/{{file}}.pdf {{file}}.pdf

# Rebuild on every save outside VS Code.
watch file=main:
    latexmk -pvc -view=none {{file}}.tex

# Overfull boxes and missing glyphs: on a poster these are visible defects.
check file=main:
    grep -n -A1 'Overfull\|Font Warning\|undefined' build/{{file}}.log || echo "clean"

# Low-res PNG preview of the whole sheet.
preview file=main:
    pdftoppm -png -r 30 -singlefile {{file}}.pdf preview

clean:
    latexmk -C
    rm -f preview.png
