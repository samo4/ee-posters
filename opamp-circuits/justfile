# Slide build. latexmkrc holds the engine and the build/ dir; the finished PDF is copied
# next to the source so an open viewer tab (vscode-pdf) reloads it in place.
# Both slides share preamble.tex; each top file only does its own content.
main := "opamp-circuits"
mccoy := "the-real-mccoy"

default: (poster main) (poster mccoy)

poster file=main:
    latexmk {{file}}.tex
    cp build/{{file}}.pdf {{file}}.pdf

# Rebuild on every save outside VS Code.
watch file=main:
    latexmk -pvc -view=none {{file}}.tex

# Overfull boxes and missing glyphs: on a slide these are visible defects.
check file=main:
    grep -n -A1 'Overfull\|Font Warning\|undefined' build/{{file}}.log || echo "clean"

# Low-res PNG preview of the slide.
preview file=main:
    pdftoppm -png -r 30 -singlefile {{file}}.pdf preview

clean:
    latexmk -C
    rm -f preview.png
