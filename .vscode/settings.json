{
  "files.associations": {
    "justfile": "just"
  },
  "[just]": {
    "editor.formatOnSave": false,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "runOnSave.commands": [
    {
      // a top-level poster file: rebuild just that one
      "match": "[\\\\/](ee-ten-commandments[^\\\\/]*|lnas-poster|screw-drives)\\.tex$",
      "command": "cd \"${fileDirname}\" && just poster \"${fileBasenameNoExtension}\"",
      "runIn": "terminal",
      "terminalReveal": "onError"
    },
    {
      // shared content: every format uses it, so rebuild them all; just finds the poster's justfile upward
      "match": "[\\\\/](preamble\\.tex|blocks[\\\\/][^\\\\/]*\\.tex)$",
      "command": "cd \"${fileDirname}\" && just",
      "runIn": "terminal",
      "terminalReveal": "onError"
    }
  ]
}
