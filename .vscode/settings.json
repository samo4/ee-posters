{
  "files.associations": {
    "justfile": "just"
  },
  "[just]": {
    "editor.formatOnSave": false,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "runOnSave.commands": [
    {
      // a top-level poster file: rebuild just that format
      "match": "[\\\\/]ee-ten-commandments[^\\\\/]*\\.tex$",
      "command": "cd \"$(git rev-parse --show-toplevel)\" && just poster \"${fileBasenameNoExtension}\"",
      "runIn": "terminal",
      "terminalReveal": "onError"
    },
    {
      // shared content: every format uses it, so rebuild both
      "match": "[\\\\/](preamble\\.tex|blocks[\\\\/][^\\\\/]*\\.tex)$",
      "command": "cd \"$(git rev-parse --show-toplevel)\" && just",
      "runIn": "terminal",
      "terminalReveal": "onError"
    }
  ]
}
